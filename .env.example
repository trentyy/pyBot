# 複製成 .env 後填入。.env 不會被 git 追蹤。

# 必填：Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# 自動身分組需要 Developer Portal 開啟 SERVER MEMBERS INTENT；沒開的話設為 false
ENABLE_MEMBERS_INTENT=true

# 資料庫與 log 位置（相對於專案根目錄）
DB_PATH=data/dc-manager.db
LOG_DIR=logs
LOG_LEVEL=INFO

# 開發用：填入測試伺服器 ID，斜線指令會立即同步到該伺服器（正式環境請留空）
DEV_GUILD_ID=

# 選填：若樹莓派只能透過 HTTP proxy 連外，填入 proxy 位址，例如 http://192.168.1.10:3128
DISCORD_PROXY=

# ---------- 儀器警報 ----------
# 區網接收器：儀器電腦用 HTTP 把數值送到 http://<樹莓派IP>:<PORT>/api/v1/readings
ALARM_HTTP_ENABLED=false
ALARM_HTTP_HOST=0.0.0.0
ALARM_HTTP_PORT=8080
# PostgreSQL 輪詢設定檔（檔案不存在就不輪詢），範例見 alarm_sources.example.toml
ALARM_SOURCES_FILE=alarm_sources.toml
# 若 alarm_sources.toml 用 dsn_env，在這裡放連線字串
# LAB_PG_DSN=postgresql://readonly:密碼@192.168.1.20:5432/lab
